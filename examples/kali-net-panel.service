[Unit]
Description=MOH HTTPS LAN Administration with password authentication
After=network-online.target dnsmasq.service share-internet.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/local/lib/kali-net-panel
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=KNP_SERVICE=1
Environment=KNP_ROLE=admin_lan
Environment=KNP_PUBLIC_URL=http://192.168.5.1
Environment=KNP_ADMIN_URL=https://192.168.100.1
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/python3 /usr/local/lib/kali-net-panel/panel.py --init
ExecStart=/usr/bin/python3 -m gunicorn --no-control-socket --workers 1 --threads 4 --timeout 30 --bind 192.168.100.1:443 --certfile /var/lib/kali-net-panel/cert.pem --keyfile /var/lib/kali-net-panel/key.pem --access-logfile - --error-logfile - panel:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kali-net-panel
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=192.168.5.0/24
IPAddressAllow=127.0.0.1/32
IPAddressAllow=192.168.100.1/32
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=multi-user.target
